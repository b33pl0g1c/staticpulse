# Copy to .env and fill in. Only needed for the LLM layer (Phase 2+).
# Without it, `staticpulse scan` still runs — deterministic, scanners-only.

# Groq free tier (no card): https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides:
# STATICPULSE_LLM_PROVIDER=groq
# STATICPULSE_LLM_MODEL=openai/gpt-oss-20b   # model list varies by account;
#                                            # check https://console.groq.com/docs/models
